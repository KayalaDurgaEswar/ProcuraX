# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# AI / LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-coder

# Commerce / Beckn Configuration
# mock = in-process fixtures, sandbox = full local HTTP lifecycle, real = ONDC/Beckn network
DEFAULT_NETWORK_PROVIDER=sandbox
BECKN_GATEWAY_URL=http://127.0.0.1:3000/beckn/gateway
BECKN_BAP_ID=procura-local-bap
BECKN_BAP_URI=http://127.0.0.1:3000/beckn/bap
# Required only when DEFAULT_NETWORK_PROVIDER=real. Never commit private keys.
ONDC_UNIQUE_KEY_ID=
ONDC_SIGNING_PRIVATE_KEY=
BECKN_DOMAIN=nic2004:52110
BECKN_COUNTRY=IND
BECKN_CITY=std:040
BECKN_PROTOCOL_VERSION=1.1.0
BECKN_REQUEST_TIMEOUT_MS=5000
BECKN_CALLBACK_TIMEOUT_MS=7000
BECKN_CALLBACK_SETTLE_MS=350
BECKN_TRANSACTION_TTL_MS=600000
BECKN_ALLOW_MOCK_FALLBACK=false
BECKN_ALLOW_UNSIGNED_CALLBACKS=false
BECKN_SIGNATURE_MAX_AGE_SECONDS=3600
# Map "subscriber_id|unique_key_id" (or subscriber_id) to base64 Ed25519 public keys.
BECKN_CALLBACK_PUBLIC_KEYS_JSON={}

# Enterprise Approval Policy (Values in INR)
AUTO_APPROVAL_THRESHOLD_INR=50000
MANAGER_APPROVAL_THRESHOLD_INR=500000

# MongoDB connection. Never commit real credentials.
# Local example:
MONGODB_URI=mongodb://localhost:27017/procurax
# Development-only escape hatch. Production fails closed unless explicitly enabled.
ALLOW_EMBEDDED_DB_FALLBACK=false
# Tests always use this isolated database (or embedded Mongo if unavailable).
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/procurax-test
# Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Default demo identities
DEFAULT_ORG_ID=org_acme_corp_001
DEFAULT_USER_ID=user_procurement_lead
